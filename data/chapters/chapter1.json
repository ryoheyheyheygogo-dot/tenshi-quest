  "dialogues": {
    "intro": [
      {
        "speaker": "narrator",
        "text": "ここは てんし ようちえんの えんてい。",
        "voice": "ch1/intro_01"
      },
      {
        "speaker": "narrator",
        "text": "えんちょうせんせいが {name}を よんでいるよ。",
        "voice": "ch1/intro_02"
      },
      {
        "speaker": "narrator",
        "text": "いきたい ところを タッチすると あるけるよ。",
        "voice": "ch1/intro_03"
      }
    ],
    "encho_first": [
      {
        "speaker": "encho",
        "text": "ようこそ、{name}！ まっていたよ。",
        "voice": "ch1/encho_first_01"
      },
      {
        "speaker": "encho",
        "text": "てんし ようちえんは ことしで 75さいの おたんじょうび なんだよ。",
        "voice": "ch1/encho_first_02"
      },
      {
        "speaker": "encho",
        "text": "でもね、ようちえんの あちこちに なかよしモンスターが あらわれて こまっているの。",
        "voice": "ch1/encho_first_03"
      },
      {
        "speaker": "encho",
        "text": "モンスターと なかよしに なって、『えがおの かけら』を あつめて くれるかな？",
        "voice": "ch1/encho_first_04"
      },
      {
        "speaker": "encho",
        "text": "えんていに いる モンスターに はなしかけて みてね。",
        "voice": "ch1/encho_first_05"
      }
    ],
    "encho_hint": [
      {
        "speaker": "encho",
        "text": "モンスターは あと {remaining}ひき いるよ。がんばってね！",
        "voice": ""
      }
    ],
    "encho_clear": [
      {
        "speaker": "encho",
        "text": "わあ！ モンスターと みんな なかよしに なれたね！",
        "voice": "ch1/encho_clear_01"
      },
      {
        "speaker": "encho",
        "text": "ありがとう、{name}。これは だい1しょうの 『えがおの かけら』だよ。",
        "voice": "ch1/encho_clear_02"
      },
      {
        "speaker": "encho",
        "text": "これで 『ときの とびら』が ひらくよ。むかしの ようちえんへ いってみよう！",
        "voice": "ch1/encho_clear_03"
      }
    ],
    "encho_after": [
      {
        "speaker": "encho",
        "text": "ときの とびらから いろんな じだいへ いけるよ。",
        "voice": "ch1/encho_after_01"
      }
    ],
    "all_friends": [
      {
        "speaker": "narrator",
        "text": "えんていの モンスターと みんな なかよしに なった！",
        "voice": "ch1/all_friends_01"
      },
      {
        "speaker": "narrator",
        "text": "えんちょうせんせいの ところへ もどろう！",
        "voice": "ch1/all_friends_02"
      }
    ],
    "monster_locked": [
      {
        "speaker": "narrator",
        "text": "なにか いるみたい…。さきに えんちょうせんせいに あいに いこう。",
        "voice": "ch1/monster_locked_01"
      }
    ],
    "sukikirai_appear": [
      {
        "speaker": "narrator",
        "text": "あっ！ モンスターだ！",
        "voice": "ch1/sukikirai_appear_01"
      }
    ],
    "sukikirai_friend": [
      {
        "speaker": "narrator",
        "text": "すききらいモンスター「ピーマン ひとくち たべられたよ！ ありがとう！」",
        "voice": "ch1/sukikirai_friend_01"
      }
    ],
    "chirakari_appear": [
      {
        "speaker": "narrator",
        "text": "あっ！ モンスターだ！",
        "voice": "ch1/chirakari_appear_01"
      }
    ],
    "chirakari_friend": [
      {
        "speaker": "narrator",
        "text": "ちらかりレッド「かたづけたら きもちいいね！」",
        "voice": "ch1/chirakari_friend_01"
      }
    ],
    "chest1": [
      {
        "speaker": "narrator",
        "text": "たからばこを あけた！ なかに なにか はいっているよ。",
        "voice": "ch1/chest1_01"
      }
    ],
    "chest_empty": [
      {
        "speaker": "narrator",
        "text": "たからばこは からっぽだ。",
        "voice": "ch1/chest_empty_01"
      }
    ]
  }
