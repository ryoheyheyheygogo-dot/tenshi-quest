  "dialogues": {
    "intro": [
      {
        "speaker": "narrator",
        "text": "ときの とびらを くぐると… ここは しょうわの ようちえん！",
        "voice": "ch3/intro_01"
      },
      {
        "speaker": "narrator",
        "text": "えんしゃが いまと ちがうね。こどもが ひとり いるよ。",
        "voice": "ch3/intro_02"
      }
    ],
    "npc_first": [
      {
        "speaker": "kodomo",
        "text": "あれ？ みたことない ふく！ どこから きたの？",
        "voice": "ch3/npc_first_01"
      },
      {
        "speaker": "kodomo",
        "text": "いま、ほこりんぼと ぷんぷんバイキンが あばれて いるの。",
        "voice": "ch3/npc_first_02"
      },
      {
        "speaker": "kodomo",
        "text": "いっしょに なかよく なって くれる？",
        "voice": "ch3/npc_first_03"
      }
    ],
    "npc_hint": [
      {
        "speaker": "kodomo",
        "text": "あと {remaining}ひき だよ！",
        "voice": ""
      }
    ],
    "npc_clear": [
      {
        "speaker": "kodomo",
        "text": "すごい！ みんな なかよしに なったね！",
        "voice": "ch3/npc_clear_01"
      },
      {
        "speaker": "kodomo",
        "text": "これ、たからものの 『えがおの かけら』。あげる！",
        "voice": "ch3/npc_clear_02"
      }
    ],
    "npc_after": [
      {
        "speaker": "kodomo",
        "text": "おとなに なっても この ようちえんの こと わすれないよ。",
        "voice": "ch3/npc_after_01"
      }
    ],
    "monster_locked": [
      {
        "speaker": "narrator",
        "text": "なにか いるみたい…。さきに こどもに はなしかけて みよう。",
        "voice": "ch3/monster_locked_01"
      }
    ],
    "monster_appear": [
      {
        "speaker": "narrator",
        "text": "あっ！ モンスターだ！",
        "voice": "ch3/monster_appear_01"
      }
    ],
    "hokorin_friend": [
      {
        "speaker": "narrator",
        "text": "ほこりんぼ「ぴかぴかの えんしゃ、きもちいいね！」",
        "voice": "ch3/hokorin_friend_01"
      }
    ],
    "kenka_friend": [
      {
        "speaker": "narrator",
        "text": "ぷんぷんバイキン「ごめんねって いえたよ！」",
        "voice": "ch3/kenka_friend_01"
      }
    ],
    "all_friends": [
      {
        "speaker": "narrator",
        "text": "この じだいの モンスターと みんな なかよしに なった！",
        "voice": "ch3/all_friends_01"
      },
      {
        "speaker": "narrator",
        "text": "こどもの ところへ もどろう！",
        "voice": "ch3/all_friends_02"
      }
    ]
  }
