  "dialogues": {
    "intro": [
      {
        "speaker": "narrator",
        "text": "ときの とびらを くぐると… ここは 75ねん まえ、はじまりの ようちえん！",
        "voice": "ch4/intro_01"
      },
      {
        "speaker": "narrator",
        "text": "ちいさな えんしゃの まえに だれか いるよ。",
        "voice": "ch4/intro_02"
      }
    ],
    "npc_first": [
      {
        "speaker": "founder",
        "text": "ようこそ、{name}。わたしが この ようちえんを つくったんだよ。",
        "voice": "ch4/npc_first_01"
      },
      {
        "speaker": "founder",
        "text": "こどもたちが えがおで そだつ ばしょに したくてね。",
        "voice": "ch4/npc_first_02"
      },
      {
        "speaker": "founder",
        "text": "でも はずかしがりプラントと はらぺこミルクが まだ なじめないんだ。たすけて くれるかい？",
        "voice": "ch4/npc_first_03"
      }
    ],
    "npc_hint": [
      {
        "speaker": "founder",
        "text": "あと {remaining}ひき。ゆっくりで いいよ。",
        "voice": ""
      }
    ],
    "npc_clear": [
      {
        "speaker": "founder",
        "text": "ありがとう。きみの えがおが みんなを げんきに したね。",
        "voice": "ch4/npc_clear_01"
      },
      {
        "speaker": "founder",
        "text": "さいごの 『えがおの かけら』だよ。75ねんごの ようちえんを よろしくね。",
        "voice": "ch4/npc_clear_02"
      }
    ],
    "npc_after": [
      {
        "speaker": "founder",
        "text": "この ようちえんが ずっと えがおで いっぱい でありますように。",
        "voice": "ch4/npc_after_01"
      }
    ],
    "monster_locked": [
      {
        "speaker": "narrator",
        "text": "なにか いるみたい…。さきに ようちえんを つくった ひとに はなしかけて みよう。",
        "voice": "ch4/monster_locked_01"
      }
    ],
    "monster_appear": [
      {
        "speaker": "narrator",
        "text": "あっ！ モンスターだ！",
        "voice": "ch4/monster_appear_01"
      }
    ],
    "hazukashi_friend": [
      {
        "speaker": "narrator",
        "text": "はずかしがりプラント「おはようって いえたよ！」",
        "voice": "ch4/hazukashi_friend_01"
      }
    ],
    "harapeko_friend": [
      {
        "speaker": "narrator",
        "text": "はらぺこミルク「いただきます！ みんなで たべると おいしい！」",
        "voice": "ch4/harapeko_friend_01"
      }
    ],
    "all_friends": [
      {
        "speaker": "narrator",
        "text": "この じだいの モンスターと みんな なかよしに なった！",
        "voice": "ch4/all_friends_01"
      },
      {
        "speaker": "narrator",
        "text": "ようちえんを つくった ひとの ところへ もどろう！",
        "voice": "ch4/all_friends_02"
      }
    ]
  }
}